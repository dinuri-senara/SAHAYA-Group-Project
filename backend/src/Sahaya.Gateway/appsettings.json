{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-admin-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        }
      },
      "assistance-requests-route": {
        "ClusterId": "assistance-cluster",
        "Match": {
          "Path": "/api/v1/requests/{**catch-all}"
        }
      },
      "assistance-emergency-route": {
        "ClusterId": "assistance-cluster",
        "Match": {
          "Path": "/api/v1/emergency/{**catch-all}"
        }
      },
      "assistance-citizen-route": {
        "ClusterId": "assistance-cluster",
        "Match": {
          "Path": "/api/v1/citizen/{**catch-all}"
        }
      },
      "coordination-incidents-route": {
        "ClusterId": "coordination-cluster",
        "Match": {
          "Path": "/api/v1/incidents/{**catch-all}"
        }
      },
      "coordination-coordinator-route": {
        "ClusterId": "coordination-cluster",
        "Match": {
          "Path": "/api/v1/coordinator/{**catch-all}"
        }
      },
      "logistics-shelters-route": {
        "ClusterId": "logistics-cluster",
        "Match": {
          "Path": "/api/v1/shelters/{**catch-all}"
        }
      },
      "logistics-resources-route": {
        "ClusterId": "logistics-cluster",
        "Match": {
          "Path": "/api/v1/resources/{**catch-all}"
        }
      },
      "operations-volunteers-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/v1/volunteers/{**catch-all}"
        }
      },
      "operations-donations-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/v1/donations/{**catch-all}"
        }
      },
      "operations-gis-route": {
        "ClusterId": "operations-cluster",
        "Match": {
          "Path": "/api/v1/operations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "assistance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "coordination-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "logistics-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "operations-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
